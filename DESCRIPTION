Package: fastEmbedR
Type: Package
Title: Native UMAP and Interpolation-Based t-SNE Embeddings
Version: 0.1
Authors@R: person(
    given = "Stefano",
    family = "Cacciatore",
    role = c("aut", "cre"),
    email = "tkcaccia@gmail.com",
    comment = c(ORCID = "0000-0001-7052-7156")
