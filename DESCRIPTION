Package: fastEmbedR
Type: Package
Title: Native Embeddings, PCA, and Graph Clustering
Version: 0.1
Authors@R: person(
    given = "Stefano",
    family = "Cacciatore",
    role = c("aut", "cre"),
    email = "tkcaccia@gmail.com",
    comment = c(ORCID = "0000-0001-7052-7156")
