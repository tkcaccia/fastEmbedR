CXX_STD = CXX17
# R adds $(OBJC_LIBS) when Objective-C++ sources are present in the source
# tarball, even though Windows builds only the C++ Metal stubs listed below.
override OBJC_LIBS =
OBJECTS = RcppExports.o tsne_neighbors.o embedding_utils.o massive_matrix.o massive_graph_merge.o massive_graph_reorder.o fast_knn_umap.o graph_clustering.o graph_clustering_cuda_bridge.o graph_clustering_metal_bridge.o faissr_hnsw_bridge.o graph_clustering_cuda_stub.o embedding_metal_bridge.o embedding_metal_stub.o graph_clustering_metal_stub.o embedding_cuda_bridge.o embedding_cuda_stub.o
